# Conexión a PostgreSQL (Supabase)
DATABASE_URL="postgresql://usuario:password@host:5432/basedatos"

# Clave de cifrado en reposo (Fernet). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No versionar este valor. Si se pierde, los datos cifrados no se pueden recuperar.
# En Streamlit Community Cloud, defina DATABASE_URL y FERNET_KEY en Secrets.
FERNET_KEY=""

# Fase 15: correo de recordatorio desde la cuenta de SETESA (ver docs/CORREO.md).
# Use una contraseña de aplicación, nunca la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
# Enlace a la aplicación publicada (se incluye en los correos).
APP_URL=

# Fase 17: repositorio persistente de expedientes (Supabase Storage, bucket privado).
# La llave secreta salta todas las reglas de acceso: solo en .env y en el servidor.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=expedientes

# Fase 20: expiración de la sesión (valores por defecto).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
